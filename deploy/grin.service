# /etc/systemd/system/grin.service
[Unit]
Description=Le Grin (Gunicorn)
After=network.target

[Service]
User=grin
WorkingDirectory=/srv/grin
EnvironmentFile=/srv/grin/.env
ExecStart=/srv/grin/.venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8000 --workers 3 --access-logfile -
Restart=always

[Install]
WantedBy=multi-user.target
