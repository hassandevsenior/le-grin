# Copier en .env et adapter. Ne jamais mettre le vrai .env dans Git.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=mon-domaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mon-domaine.com
# Mettre 1 si aucun serveur web (Nginx) ne sert /media/ devant Django.
DJANGO_SERVE_MEDIA=1
# Mettre 0 si le HTTPS n'est pas encore en place (sinon redirection en boucle).
DJANGO_SSL_REDIRECT=1
# Chemins des données, hors du dossier du code de préférence.
# DJANGO_DB_PATH=/var/lib/grin/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/grin/media
SITE_NAME=Le Grin
